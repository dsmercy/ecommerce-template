# API — all requests go through this base URL
# Phase 1 used port 56438 for the log receiver; Phase 2 uses the full API
VITE_API_BASE_URL=https://localhost:56437

# App environment label (shows up in Grafana log streams)
VITE_APP_ENV=development

# Sentry DSN — leave blank to disable error monitoring in dev
# VITE_SENTRY_DSN=
