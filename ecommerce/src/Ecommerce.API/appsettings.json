{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=ecommerce_db;User=root;Password=your_password;CharSet=utf8mb4;",
    "Redis": "localhost:6379"
  },

  "JwtSettings": {
    "Secret": "YOUR_SUPER_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG",
    "Issuer": "EcommerceAPI",
    "Audience": "EcommerceClients",
    "ExpiryMinutes": "60"
  },

  "AzureBlobStorage": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net",
    "ContainerName": "ecommerce-media"
  },

  "Meilisearch": {
    "Host": "http://localhost:7700",
    "ApiKey": "YOUR_MEILISEARCH_MASTER_KEY"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },

  "AllowedHosts": "*"
}
